---
import { readJson, scenarios } from "../lib/data";

const indices = scenarios().map((s) => readJson(`public/demo/${s.id}/index.json`));
---

<section id="demo">
  <div class="wrap">
    <span class="eyebrow">Interactive demo</span>
    <h2>Watch an agent make game audio</h2>
    <p class="lede">
      Choose your own adventure: pick what you're building, then what to ask for next. Start over to take another path. Each reply has the sounds (press play), their listen sheets, what the
      agent wrote, and the files your game gets.
    </p>
    <p class="honest">
      A scripted conversation. The sounds, listen sheets, source files, diffs, lint results and build output
      are real SEGAN output, rebuilt from the source files in this site's repo.
    </p>
    <div class="demo panel" id="demo-root" data-indices={JSON.stringify(indices)}>
      <div class="log" aria-live="polite"></div>
      <div class="choices" aria-label="Your reply"></div>
    </div>
  </div>
</section>

<script>
  import { mountDemo } from "../scripts/demo";
  mountDemo(document.getElementById("demo-root")!);
</script>

<style is:global>
  #demo .honest {
    display: inline-block;
    font-size: 0.88rem;
    color: var(--ice);
    border: 1px dashed rgba(165, 216, 255, 0.4);
    border-radius: var(--radius);
    padding: 6px 12px;
    margin: 4px 0 24px;
  }
  .demo {
    padding: 0;
    overflow: hidden;
  }
  .demo .log {
    padding: 22px 22px 6px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 320px;
  }
  .msg {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 12px;
    scroll-margin-top: 80px;
  }
  .msg .who {
    font: 0.8rem var(--font-pixel);
    color: var(--muted);
    padding-top: 10px;
  }
  .msg .body {
    min-width: 0;
  }
  .msg.you .body {
    justify-self: start;
    background: var(--violet);
    color: var(--ink);
    border-radius: 2px 12px 12px 12px;
    padding: 10px 16px;
    font-weight: 550;
  }
  .msg.agent .who {
    color: var(--amber);
  }
  .msg.agent .body > p {
    margin: 8px 0 14px;
    max-width: 60rem;
  }
  .sounds {
    display: grid;
    gap: 18px;
  }
  .sounds.n2,
  .sounds.n3 {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }
  .sound {
    min-width: 0;
  }
  .sound .sname {
    font-size: 0.85rem;
    margin-bottom: 6px;
  }
  .sound .sname b {
    font: 400 0.9rem var(--font-mono);
    color: var(--text);
  }
  .sound .sname span {
    color: var(--muted);
    font-size: 0.8rem;
    margin-left: 6px;
  }
  .sound .nums {
    font: 0.75rem var(--font-mono);
    color: var(--muted);
    margin: 6px 0 0;
  }
  .sound .note {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 8px 0 0;
  }
  .sound figure.seam {
    margin: 14px 0 0;
  }
  .sound figure.seam img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  .sound figure.seam figcaption {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 6px;
  }
  details.first > summary span {
    color: var(--del);
  }
  .lintout {
    color: var(--del);
    white-space: pre-wrap;
    margin-bottom: 10px;
  }
  details.more {
    margin-top: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--night);
  }
  details.more > summary {
    cursor: pointer;
    padding: 10px 14px;
    font: 0.9rem var(--font-pixel);
    list-style: none;
  }
  details.more > summary::before {
    content: "▸ ";
    color: var(--wave);
  }
  details.more[open] > summary::before {
    content: "▾ ";
  }
  details.more > summary span {
    font: 0.8rem var(--font-body);
    color: var(--muted);
    margin-left: 8px;
  }
  .more-body {
    padding: 0 14px 14px;
  }
  .more-body h4 {
    font: 0.78rem var(--font-pixel);
    color: var(--muted);
    margin: 16px 0 6px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .more-body .code {
    font-size: 12.5px;
    max-height: 420px;
  }
  details.file {
    margin-bottom: 8px;
  }
  details.file > summary {
    cursor: pointer;
    font-size: 0.88rem;
    padding: 4px 0;
  }
  details.file .st {
    font: 0.72rem var(--font-pixel);
    color: var(--muted);
  }
  details.file .st.added {
    color: var(--add);
  }
  details.file .st.modified {
    color: var(--wave);
  }
  details.file .n b {
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  details.file .n .a {
    color: var(--add);
  }
  details.file .n .r {
    color: var(--del);
  }
  .demo .choices {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    padding: 14px 22px 22px;
    border-top: 1px solid var(--line);
    background: var(--panel-2);
    min-height: 70px;
    align-items: center;
  }
  .choice {
    font: 0.95rem var(--font-body);
    font-weight: 550;
    background: transparent;
    color: var(--wave);
    border: 2px solid var(--violet);
    border-radius: 18px;
    padding: 8px 16px;
    cursor: pointer;
  }
  .choice:hover {
    background: var(--violet);
    color: var(--ink);
  }
  .choice.restart {
    margin-right: auto;
    border-color: var(--line);
    color: var(--muted);
  }
  .choice.restart:hover {
    background: var(--panel);
    color: var(--text);
  }
  .typing {
    color: var(--muted);
    font-size: 0.9rem;
    margin-right: auto;
  }
  @media (max-width: 640px) {
    .msg {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .msg .who {
      padding-top: 0;
    }
    .demo .log {
      padding: 16px 12px 4px;
    }
    .demo .choices {
      padding: 12px;
    }
  }
</style>
