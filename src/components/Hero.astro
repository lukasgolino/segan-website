---
import { playerData, readJson, readText } from "../lib/data";
import { highlightSource } from "../scripts/highlight";

const hero = readJson("public/demo/hero.json");
const theme = hero.sounds.theme;
const source = readText("art/hero/music/theme.song.yaml").trimEnd();
const lines = source.split("\n").length;
const m = hero.manifest;
---

<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <span class="eyebrow">Sound Effect Grammar And Notation</span>
      <h1>You speak English.<br /><span>Your agent speaks SEGAN.</span></h1>
      <p class="lede">
        SEGAN is a language for game audio: instrument kits, sound effects, music patterns and mix rules,
        written as plain text. Your AI agent writes it, SEGAN checks and renders it, and your game gets
        engine-ready WAVs, loop points and a manifest.
      </p>
      <div class="cta">
        <a class="btn" href="#demo">Try the demo</a>
        <a class="btn ghost" href="#install">Install (1 line)</a>
      </div>
      <ul class="facts">
        <li>MIT-licensed, free</li>
        <li>Runs locally, offline</li>
        <li>No account, no credits</li>
        <li>The sound is yours</li>
      </ul>
      <p class="sister">
        Sister library of <a href="https://lukasgolino.com/pagan-website/">PAGAN</a>, the same idea for pixel art.
      </p>
    </div>
    <figure class="show panel">
      <segan-player data-player={playerData(theme, "demo/", { loop: true })}></segan-player>
      <figcaption>
        <span>A {m.bars}-bar loop at {m.bpm} bpm, from this {lines}-line file. Press play; the yellow lines are its loop points.</span>
        <code>music/theme.song.yaml</code>
      </figcaption>
      <pre class="code src" tabindex="0" aria-label="The theme's SEGAN source"><code set:html={highlightSource(source)} /></pre>
    </figure>
  </div>
</section>

<script>
  import "../scripts/widgets";
</script>

<style>
  .hero {
    border-top: 0;
    padding: 64px 0 88px;
    background:
      radial-gradient(ellipse at 80% 20%, rgba(79, 140, 255, 0.16), transparent 55%),
      radial-gradient(ellipse at 10% 90%, rgba(139, 92, 246, 0.12), transparent 50%);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 48px;
    align-items: center;
  }
  h1 {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
  }
  h1 span {
    color: var(--wave);
  }
  .cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 28px 0 22px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding: 0;
    margin: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .facts li::before {
    content: "■ ";
    color: var(--amber);
  }
  .sister {
    margin: 18px 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .show {
    margin: 0;
    padding: 14px;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
    margin: 12px 2px 8px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .src {
    max-height: 260px;
    font-size: 12px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
