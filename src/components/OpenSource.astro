---
import { asset, playerData, readJson } from "../lib/data";

const { segan } = readJson("src/content/docs/meta.json");
const jingle = readJson("public/demo/hero.json").sounds.jingle;
---

<section id="open-source">
  <div class="wrap grid">
    <div>
      <span class="eyebrow">Open source</span>
      <h2>Free, for good</h2>
      <p class="lede">
        SEGAN is MIT-licensed. Every released version stays free to use, change and ship, commercially or
        not. No account, no telemetry, no cloud: it runs on your machine.
      </p>
      <ul>
        <li>Source, issues and releases on <a href="https://github.com/lukasgolino/segan">GitHub</a></li>
        <li>Current release: <b>v{segan}</b>, see the <a href={asset("docs/changelog/")}>changelog</a></li>
        <li>
          Contributing: open an issue first for notation changes; every feature lands with tests, output
          stays byte-identical, and anything that changes rendered samples gets a version bump.
        </li>
        <li>Game repos pin a tag, so your sounds never change under you.</li>
        <li>Sister library: <a href="https://pagan.top/">PAGAN</a> (pixel art), same design, same workflow.</li>
      </ul>
    </div>
    <div class="badge panel">
      <img class="px" src={asset("brand/mark@12x.png")} width="192" height="192" alt="The SEGAN icon, a speech bubble holding a waveform" />
      <p>MIT · free forever · icon made with PAGAN</p>
      <div class="jingle">
        <segan-player data-player={playerData(jingle, "demo/", { compact: true })}></segan-player>
      </div>
      <p class="small">SEGAN's sound logo, made with SEGAN: <code>sfx/jingle.sfx.yaml</code></p>
    </div>
  </div>
</section>

<script>
  import "../scripts/widgets";
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  ul {
    color: var(--muted);
    padding-left: 1.2em;
  }
  li {
    margin-bottom: 6px;
  }
  li b {
    color: var(--text);
  }
  .badge {
    text-align: center;
    padding: 32px;
  }
  .badge img {
    max-width: 100%;
    height: auto;
  }
  .badge p {
    font: 0.8rem var(--font-pixel);
    color: var(--muted);
    margin: 14px 0 0;
  }
  .badge .small {
    font: 0.78rem var(--font-body);
  }
  .jingle {
    text-align: left;
    margin-top: 16px;
  }
  @media (max-width: 800px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
