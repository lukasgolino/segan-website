---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = "og/segan.png" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const url = (p: string) => base + p.replace(/^\//, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const nav = [
  ["Demo", "#demo"],
  ["Features", "#features"],
  ["Compare", "#compare"],
  ["Install", "#install"],
  ["Docs", "docs/"],
];
const pagan = "https://pagan.top/";
const kiln = "https://kiln3d.dev/";
const home = Astro.url.pathname.replace(/\/?$/, "/") === base;
// Structured data (schema.org) for search engines and AI assistants.
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "SEGAN",
      "url": "https://segan.top/"
    },
    {
      "@type": "SoftwareApplication",
      "name": "SEGAN",
      "alternateName": "Sound Effect Grammar And Notation",
      "url": "https://segan.top/",
      "description": "Free, open-source language for game audio. An AI agent writes it; SEGAN lints and renders it into matching sound effects and seamless music loops, with WAVs, loop points and Godot resources.",
      "applicationCategory": "DeveloperApplication",
      "applicationSubCategory": "Game development: sound effects and music",
      "operatingSystem": "Windows, macOS, Linux",
      "softwareRequirements": "Python 3.11+",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "isAccessibleForFree": true,
      "license": "https://www.apache.org/licenses/LICENSE-2.0",
      "downloadUrl": "https://github.com/lukasgolino/SEGAN",
      "sameAs": [
        "https://github.com/lukasgolino/SEGAN"
      ],
      "keywords": "sound effect generator, game audio, AI sound effects, game music, Godot, Godot 4, MCP server, gamedev, indie game development",
      "author": {
        "@id": "https://lukasgolino.com/#me"
      }
    },
    {
      "@type": "Person",
      "@id": "https://lukasgolino.com/#me",
      "name": "Lukas Golino",
      "url": "https://lukasgolino.com/",
      "sameAs": [
        "https://github.com/lukasgolino"
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="96x96" href={url("favicon-96x96.png")} />
    <link rel="shortcut icon" href={url("favicon.ico")} />
    <link rel="apple-touch-icon" sizes="180x180" href={url("apple-touch-icon.png")} />
    <link rel="manifest" href={url("site.webmanifest")} />
    <meta name="theme-color" content="#10121f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {home && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={base} aria-label="SEGAN home">
          <img class="px" src={url("brand/logo@4x.png")} width="136" height="32" alt="SEGAN" />
        </a>
        <nav aria-label="Main">
          {nav.map(([label, href]) => <a href={href.startsWith("#") ? (home ? href : base + href) : url(href)}>{label}</a>)}
          <a class="sister" href={pagan} title="PAGAN, SEGAN's sister library: pixel art">PAGAN ↗</a>
          <a class="sister" href={kiln} title="KILN, SEGAN's sister library: smooth 3D models">KILN ↗</a>
          <a class="gh" href="https://github.com/lukasgolino/segan">GitHub</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="wrap foot">
        <div>
          <img class="px" src={url("brand/mark@2x.png")} width="32" height="32" alt="" />
          <p>
            SEGAN: Sound Effect Grammar And Notation. Apache-2.0 licensed, free, no account.<br />
            Every sound and listen sheet on this site was made with SEGAN; the logo and icon with its
            sister, <a href={pagan}>PAGAN</a>. For 3D models, see <a href={kiln}>KILN</a>.
          </p>
        </div>
        <nav aria-label="Footer">
          <a href={url("docs/")}>Docs</a>
          <a href={url("docs/reference/")}>Reference</a>
          <a href={url("docs/changelog/")}>Changelog</a>
          <a href={pagan}>PAGAN (pixel art)</a>
          <a href={kiln}>KILN (3D)</a>
          <a href="https://github.com/lukasgolino/segan">GitHub</a>
          <a href="https://github.com/lukasgolino/segan/blob/main/LICENSE">Apache License 2.0</a>
          <a href="https://lukasgolino.com/privacy.html">Privacy</a>
        </nav>
      </div>
    </footer>
    <!-- Cloudflare Web Analytics: cookieless, no consent banner needed. Production builds only, so dev/preview visits aren't counted. -->
    {import.meta.env.PROD && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "f7ea2c59a1dc49bb9352a87c8da95570"}'></script>
    )}
    <!-- Umami: cookieless too; adds per-visit page journeys. One Umami website for all our sites (filter by Host). -->
    {import.meta.env.PROD && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="6c3ba9da-9af9-49a9-a575-90c9cace445c"></script>
    )}
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 100;
    background: var(--violet);
    color: var(--ink);
    padding: 8px 12px;
  }
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(16, 18, 31, 0.88);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 16px;
  }
  .brand {
    display: flex;
  }
  nav {
    display: flex;
    gap: 22px;
    font-family: var(--font-pixel);
    font-size: 0.85rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--ice);
  }
  .gh {
    color: var(--text);
  }
  .sister {
    color: var(--amber);
  }
  @media (max-width: 720px) {
    .top nav a:not(.gh):not(.sister):not([href$="#demo"]) {
      display: none;
    }
    .top nav {
      gap: 12px;
    }
    .top nav a {
      white-space: nowrap;
    }
  }
  @media (max-width: 480px) {
    .top nav a[href$="#demo"] {
      display: none;
    }
  }
  footer {
    border-top: 1px solid var(--line);
    padding: 40px 0 56px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .foot > div {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .foot nav {
    flex-wrap: wrap;
    gap: 16px;
  }
</style>
